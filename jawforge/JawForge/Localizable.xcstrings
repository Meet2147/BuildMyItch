    "Side and stomach sleeping press the jaw unevenly": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir de lado o boca abajo presiona la mandíbula de forma desigual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir sur le côté ou le ventre appuie inégalement sur la mâchoire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "करवट या पेट के बल सोने से जबड़े पर असमान दबाव पड़ता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormire su un fianco o a pancia in giù preme sulla mascella in modo disuguale"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कुशीवर वा पोटावर झोपल्याने जबड्यावर असमान दाब येतो"
          }
        }
      }
    },
