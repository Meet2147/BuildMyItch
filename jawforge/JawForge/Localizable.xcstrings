    "Press the ENTIRE tongue — tip, middle and back — flat against the roof of your mouth.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona TODA la lengua — punta, medio y parte trasera — plana contra el paladar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaquez TOUTE la langue — pointe, milieu et arrière — contre le palais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी जीभ — नोक, बीच और पिछला हिस्सा — तालू से सटाकर दबाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi TUTTA la lingua — punta, centro e parte posteriore — piatta contro il palato."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संपूर्ण जीभ — टोक, मध्य आणि मागील भाग — टाळूला सपाट दाबा."
          }
        }
      }
    },
