            "state": "translated",
            "value": "10 सेकंद धरा, जॉलाइनपासून कॉलरबोनपर्यंत ताण जाणवू द्या."
          }
        }
      }
    },
    "Hold 2 min · practice until it's your default": {
      "localizations": {
        "es": {
          "stringUnit": {
