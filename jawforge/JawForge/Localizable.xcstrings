    "Stop if you feel clicking or pain in the jaw joint (TMJ).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para si sientes chasquidos o dolor en la articulación (ATM)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez si vous sentez un claquement ou une douleur à l'articulation (ATM)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जबड़े के जोड़ (TMJ) में क्लिक या दर्द महसूस हो तो रुक जाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermati se senti scatti o dolore all'articolazione (ATM)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जबड्याच्या सांध्यात (TMJ) आवाज किंवा वेदना जाणवल्यास थांबा."
          }
        }
      }
    },
    "Strength work for the muscles that shape the jaw corner.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo de fuerza para los músculos que moldean la esquina mandibular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcement des muscles qui dessinent le coin de la mâchoire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जबड़े का कोना बनाने वाली मांसपेशियों की स्ट्रेंथ ट्रेनिंग।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavoro di forza per i muscoli che modellano l'angolo mandibolare."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जबड्याचा कोपरा घडवणाऱ्या स्नायूंचा ताकद-सराव."
          }
        }
      }
    },
    "Switch sides every minute so both masseters grow evenly.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de lado cada minuto para que ambos maseteros crezcan por igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de côté chaque minute pour que les deux masséters se développent également."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर मिनट साइड बदलें ताकि दोनों मैसेटर बराबर बढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia lato ogni minuto così entrambi i masseteri crescono in modo uniforme."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दर मिनिटाला बाजू बदला म्हणजे दोन्ही मॅसेटर समान वाढतील."
          }
        }
      }
    },
