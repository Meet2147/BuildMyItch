    "Water retention from dehydration hides definition": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La retención de líquidos por deshidratación oculta la definición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La rétention d'eau due à la déshydratation masque la définition"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिहाइड्रेशन से वॉटर रिटेंशन डेफिनिशन छिपा देता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ritenzione idrica da disidratazione nasconde la definizione"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिहायड्रेशनमुळे होणारे वॉटर रिटेंशन रेखीवपणा झाकते"
          }
        }
      }
    },
    "We match the routine to the time you'll actually give it — small and daily beats big and abandoned.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustamos la rutina al tiempo que realmente le darás — poco y a diario gana a mucho y abandonado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous adaptons la routine au temps que vous lui donnerez vraiment — petit et quotidien vaut mieux que grand et abandonné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूटीन उतना ही रखते हैं जितना समय आप सच में देंगे — छोटा और रोज़ाना, बड़े और छूटे हुए से बेहतर है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adattiamo la routine al tempo che le dedicherai davvero — poco e ogni giorno batte tanto e abbandonato."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही खरोखर देऊ शकाल तेवढ्याच वेळेची दिनचर्या ठेवतो — छोटे पण रोज, हे मोठे पण सुटलेले यापेक्षा चांगले."
          }
        }
      }
    },
