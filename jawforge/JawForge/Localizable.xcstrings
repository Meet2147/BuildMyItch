    "Return to center, then glide right. Keep it slow and controlled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al centro y desliza a la derecha. Lento y controlado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez au centre, puis glissez à droite. Lentement et avec contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बीच में लौटें, फिर दाईं ओर। धीमा और नियंत्रित रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna al centro, poi scivola a destra. Lento e controllato."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मध्यभागी या, मग उजवीकडे. सावकाश आणि नियंत्रित ठेवा."
          }
        }
      }
