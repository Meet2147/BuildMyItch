            "value": "जॉलाइनची वेळ 💪"
          }
        }
      }
    },
    "Jawline visibility tracks body-fat level more than any exercise. Sharing this helps us give honest guidance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilidad de la mandíbula depende más del nivel de grasa corporal que de cualquier ejercicio. Compartirlo nos ayuda a darte una orientación honesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilité de la mâchoire dépend plus du taux de masse grasse que de tout exercice. Le partager nous aide à donner des conseils honnêtes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जॉलाइन का दिखना किसी भी व्यायाम से ज़्यादा बॉडी-फैट पर निर्भर है। यह बताने से हम ईमानदार सलाह दे पाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilità della jawline dipende più dal grasso corporeo che da qualsiasi esercizio. Condividerlo ci aiuta a darti indicazioni oneste."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जॉलाइन दिसणे कोणत्याही व्यायामापेक्षा बॉडी-फॅटवर अवलंबून असते. हे दिल्यास आम्ही प्रामाणिक मार्गदर्शन देऊ शकतो."
          }
        }
      }
    },
    "Keep every movement symmetric; watch yourself in a mirror.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén cada movimiento simétrico; mírate en un espejo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez chaque mouvement symétrique ; regardez-vous dans un miroir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर मूवमेंट सममित रखें; आईने में देखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni ogni movimento simmetrico; guardati allo specchio."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक हालचाल सममित ठेवा; आरशात पाहा."
          }
        }
      }
    },
    "Keep the range comfortable — never force the glide.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un rango cómodo — nunca fuerces el deslizamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez dans une amplitude confortable — ne forcez jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दायरा आरामदायक रखें — ग्लाइड कभी ज़बरदस्ती न करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni un'escursione comoda — non forzare mai lo scivolamento."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मर्यादा आरामदायक ठेवा — ग्लाइड कधीही जबरदस्तीने करू नका."
          }
        }
      }
    },
    "Know your numbers": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conoce tus números"
          }
        },
        "fr": {
