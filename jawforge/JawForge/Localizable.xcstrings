    "Couldn't read that photo. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer esa foto. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cette photo. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोटो पढ़ी नहीं जा सकी। फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la foto. Riprova."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो वाचता आला नाही. पुन्हा प्रयत्न करा."
          }
        }
      }
    },
    "Couldn't trace your jawline. Remove anything covering your jaw and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo trazar tu mandíbula. Despeja lo que la cubra e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de tracer votre mâchoire. Dégagez-la et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जॉलाइन ट्रेस नहीं हो पाई। जबड़े को ढकने वाली चीज़ हटाकर दोबारा कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile tracciare la jawline. Libera la mascella e riprova."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जॉलाइन ट्रेस होऊ शकली नाही. जबडा झाकणारे काही असल्यास काढा आणि पुन्हा प्रयत्न करा."
          }
        }
      }
    },
