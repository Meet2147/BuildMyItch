    "Daily habits quietly shape the lower face — these tell us where to look.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hábitos diarios moldean en silencio el tercio inferior — nos dicen dónde mirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les habitudes quotidiennes façonnent discrètement le bas du visage — elles nous disent où regarder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़ की आदतें चुपचाप निचला चेहरा गढ़ती हैं — इनसे पता चलता है कहाँ देखना है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abitudini quotidiane modellano in silenzio il volto inferiore — ci dicono dove guardare."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रोजच्या सवयी नकळत खालचा चेहरा घडवतात — यावरून कुठे पाहायचे ते कळते."
          }
        }
      }
    },
