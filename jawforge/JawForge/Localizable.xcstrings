    "Hold 10 seconds, feeling tension from jawline to collarbone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén 10 segundos, sintiendo la tensión de la mandíbula a la clavícula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez 10 secondes, en sentant la tension de la mâchoire à la clavicule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "10 सेकंड रोकें, जॉलाइन से कॉलरबोन तक तनाव महसूस करें।"
          }
        },
        "it": {
          "stringUnit": {
