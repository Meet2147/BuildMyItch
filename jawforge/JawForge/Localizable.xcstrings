            "value": "तुम्ही तोंडाने श्वास घेता का?"
          }
        }
      }
    },
    "Draw your chin straight back, as if making a double chin on purpose.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el mentón recto hacia atrás, como haciendo papada a propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reculez le menton bien droit, comme pour faire exprès un double menton."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठोड़ी को सीधा पीछे खींचें, जैसे जान-बूझकर डबल चिन बना रहे हों।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il mento dritto indietro, come a fare apposta il doppio mento."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हनुवटी सरळ मागे ओढा, जणू मुद्दाम डबल चिन करत आहात."
          }
        }
      }
    },
    "Drink 2L+ of water": {
