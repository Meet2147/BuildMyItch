          }
        }
      }
    },
    "Hold 3 seconds, release. That's one rep.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén 3 segundos, suelta. Eso es una repetición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez 3 secondes, relâchez. C'est une répétition."
