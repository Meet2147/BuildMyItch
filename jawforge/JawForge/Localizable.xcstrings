            "value": "Boca arriba"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le dos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीठ के बल"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla schiena"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठीवर"
          }
        }
      }
    },
    "One primary focus — the routine leans toward it while still covering the fundamentals.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enfoque principal — la rutina se inclina hacia él sin dejar los fundamentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objectif principal — la routine s'y oriente tout en couvrant les fondamentaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मुख्य फ़ोकस — रूटीन उसी ओर झुकेगा, बुनियादी चीज़ें फिर भी शामिल रहेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un obiettivo principale — la routine vi si orienta pur coprendo i fondamentali."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मुख्य लक्ष्य — दिनचर्या त्याकडे झुकेल, तरी मूलभूत गोष्टी राहतीलच."
          }
        }
      }
    },
    "One selfie, measured on-device. Photos never leave your phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un selfie, medido en el dispositivo. Las fotos nunca salen de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un selfie, mesuré sur l'appareil. Les photos ne quittent jamais votre téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सेल्फ़ी, डिवाइस पर ही मापी गई। फ़ोटो कभी फ़ोन से बाहर नहीं जाती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un selfie, misurato sul dispositivo. Le foto non lasciano mai il telefono."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सेल्फी, डिव्हाइसवरच मोजली जाते. फोटो कधीही फोनबाहेर जात नाहीत."
          }
        }
      }
    },
    "Only the neck moves — no jerking.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se mueve el cuello — sin tirones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le cou bouge — pas d'à-coups."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ गर्दन चले — झटका नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove solo il collo — niente strattoni."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त मान हलावी — झटका नको."
          }
        }
      }
    },
    "Open over a 3-second count, then close over 3 seconds, keeping tension the whole way.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre contando 3 segundos y cierra en 3, manteniendo la tensión todo el recorrido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez sur 3 secondes, refermez sur 3 secondes, en gardant la tension tout du long."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 सेकंड में खोलें, 3 सेकंड में बंद करें, पूरे समय तनाव बनाए रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
