            "state": "translated",
            "value": "Connaissez vos chiffres"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आँकड़े जानें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conosci i tuoi numeri"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे आकडे जाणा"
          }
        }
      }
    },
    "Left side": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lado izquierdo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Côté gauche"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाईं करवट"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lato sinistro"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डाव्या कुशीवर"
          }
        }
      }
    },
    "Lie on your back, knees bent, tongue pressed to the roof of your mouth.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Túmbate boca arriba, rodillas dobladas, lengua pegada al paladar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongez-vous sur le dos, genoux pliés, langue plaquée au palais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीठ के बल लेटें, घुटने मोड़ें, जीभ तालू से लगी रहे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiati sulla schiena, ginocchia piegate, lingua premuta al palato."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठीवर झोपा, गुडघे वाकवा, जीभ टाळूला दाबलेली."
          }
        }
      }
    },
    "Lifetime": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De por vida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइफटाइम"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A vita"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजीवन"
          }
        }
      }
    },
    "Longer than wide with an extended lower third — width-building work suits this shape more than length-adding habits.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más largo que ancho con el tercio inferior extendido — a esta forma le conviene más el trabajo de anchura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus long que large avec un tiers inférieur étiré — le travail en largeur convient mieux à cette forme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चौड़ाई से ज़्यादा लंबाई, निचला हिस्सा लंबा — इस आकार के लिए चौड़ाई बढ़ाने वाली मेहनत बेहतर है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più lungo che largo con il terzo inferiore esteso — a questa forma giova più il lavoro sulla larghezza."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रुंदीपेक्षा लांबी जास्त, खालचा भाग लांब — या आकारासाठी रुंदी वाढवणारा सराव अधिक उपयुक्त."
          }
        }
      }
    },
    "Lower back down with control. Keep shoulders on the floor.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja con control. Mantén los hombros en el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescendez avec contrôle. Gardez les épaules au sol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियंत्रण से नीचे लाएँ। कंधे ज़मीन पर रहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi con controllo. Tieni le spalle a terra."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियंत्रणात खाली आणा. खांदे जमिनीवर ठेवा."
          }
        }
      }
    },
    "Lower-face balance": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio del tercio inferior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibre du bas du visage"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निचले चेहरे का संतुलन"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio del volto inferiore"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खालच्या चेहऱ्याचे संतुलन"
          }
        }
      }
    },
    "Lower-face balance · overall definition": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio inferior · definición general"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibre du bas du visage · définition globale"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निचले चेहरे का संतुलन · कुल डेफिनिशन"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio del volto inferiore · definizione generale"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खालच्या चेहऱ्याचे संतुलन · एकूण रेखीवपणा"
          }
        }
      }
    },
    "Measurements are frontal-photo estimates and vary with lighting, angle and expression — scan under similar conditions each time and watch the trend, not a single number. Not medical advice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las medidas son estimaciones a partir de una foto frontal y varían con la luz, el ángulo y la expresión — escanea siempre en condiciones similares y sigue la tendencia, no un solo número. No es consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures sont des estimations sur photo de face et varient selon la lumière, l'angle et l'expression — scannez dans des conditions similaires et suivez la tendance plutôt qu'un chiffre isolé. Ceci n'est pas un avis médical."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माप सामने की फ़ोटो पर आधारित अनुमान हैं और रोशनी, कोण व भाव से बदलते हैं — हर बार मिलती-जुलती स्थितियों में स्कैन करें और किसी एक अंक की बजाय ट्रेंड देखें। यह चिकित्सकीय सलाह नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le misure sono stime da foto frontale e variano con luce, angolo ed espressione — scansiona in condizioni simili e osserva la tendenza, non un singolo numero. Non è un consiglio medico."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोजमापे समोरील फोटोवर आधारित अंदाज आहेत आणि प्रकाश, कोन व हावभावानुसार बदलतात — दरवेळी सारख्या परिस्थितीत स्कॅन करा आणि एका आकड्याऐवजी ट्रेंड पाहा. हा वैद्यकीय सल्ला नाही."
          }
        }
      }
    },
    "Measuring jaw angles…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Midiendo los ángulos de la mandíbula…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure des angles de la mâchoire…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जॉ एंगल मापे जा रहे हैं…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurazione degli angoli della mascella…"
          }
        },
        "mr": {
