        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "माझा प्लॅन बनवा"
          }
        }
      }
    },
    "Build up duration over weeks like any other muscle.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la duración a lo largo de semanas, como con cualquier músculo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez la durée sur plusieurs semaines, comme pour tout muscle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी मांसपेशी की तरह हफ़्तों में समय बढ़ाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la durata nel corso delle settimane, come per ogni muscolo."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतर स्नायूंप्रमाणे आठवड्यांनी कालावधी वाढवा."
          }
        }
      }
    },
    "Builds the neck that frames a sharp jawline.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrolla el cuello que enmarca una mandíbula definida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développe le cou qui met en valeur une mâchoire nette."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह गर्दन बनाता है जो शार्प जॉलाइन को फ्रेम करती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviluppa il collo che incornicia una jawline netta."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शार्प जॉलाइनला फ्रेम करणारी मान घडवते."
          }
        }
      }
    },
    "Camera access is off. Enable it in Settings → JawForge, or analyze a photo from your library below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado. Actívalo en Ajustes → JawForge o analiza una foto de tu galería abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à l'appareil photo est désactivé. Activez-le dans Réglages → JawForge, ou analysez une photo de votre bibliothèque ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा एक्सेस बंद है। सेटिंग्स → JawForge में चालू करें, या नीचे से लाइब्रेरी की फ़ोटो चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è disattivato. Attivalo in Impostazioni → JawForge oppure analizza una foto dalla libreria qui sotto."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅमेरा अ‍ॅक्सेस बंद आहे. सेटिंग्ज → JawForge मध्ये सुरू करा, किंवा खाली लायब्ररीतील फोटो निवडा."
          }
        }
      }
    },
    "Cancel anytime in Settings. The annual plan starts with a 7-day free trial — you won't be charged until it ends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela cuando quieras en Ajustes. El plan anual empieza con 7 días de prueba gratis — no se te cobrará hasta que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment dans Réglages. L'offre annuelle commence par 7 jours d'essai gratuit — aucun débit avant la fin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में कभी भी रद्द करें। वार्षिक प्लान 7 दिन के फ्री ट्रायल से शुरू होता है — ट्रायल ख़त्म होने तक कोई शुल्क नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla in qualsiasi momento nelle Impostazioni. Il piano annuale inizia con 7 giorni di prova gratuita — nessun addebito prima della fine."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्जमध्ये कधीही रद्द करा. वार्षिक प्लॅन 7 दिवसांच्या मोफत चाचणीने सुरू होतो — ती संपेपर्यंत शुल्क नाही."
          }
        }
      }
    },
    "Chew meals evenly": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastica por ambos lados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mâchez des deux côtés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाना दोनों तरफ़ से चबाएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastica da entrambi i lati"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जेवण दोन्ही बाजूंनी चावा"
          }
        }
      }
    },
    "Chew with slow, deliberate full closures — quality over speed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastica con cierres lentos y completos — calidad antes que velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mâchez avec des fermetures lentes et complètes — la qualité avant la vitesse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे और पूरी तरह बंद करते हुए चबाएँ — रफ़्तार नहीं, क्वालिटी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastica con chiusure lente e complete — qualità prima della velocità."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सावकाश, पूर्ण मिटवत चावा — वेगापेक्षा गुणवत्ता."
          }
        }
      }
    },
    "Chewing training": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrenamiento de masticación"
          }
        },
        "fr": {
