    "Nose-to-chin height as a share of eyes-to-chin height. Close to 50% is the balanced classical proportion.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura nariz-mentón como proporción de la altura ojos-mentón. Cerca del 50% es la proporción clásica equilibrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur nez-menton par rapport à la hauteur yeux-menton. Près de 50 %, c'est la proportion classique équilibrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाक-से-ठोड़ी की ऊँचाई, आँख-से-ठोड़ी की तुलना में। 50% के करीब क्लासिकल संतुलित अनुपात है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza naso-mento in rapporto all'altezza occhi-mento. Vicino al 50% è la proporzione classica equilibrata."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नाक-ते-हनुवटी उंची, डोळे-ते-हनुवटीच्या तुलनेत. 50% च्या जवळ हे क्लासिक संतुलित प्रमाण आहे."
          }
        }
      }
    },
