    "No face detected. Face the camera straight on in good light.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectó ningún rostro. Mira a la cámara de frente con buena luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun visage détecté. Placez-vous bien en face, avec un bon éclairage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई चेहरा नहीं मिला। अच्छी रोशनी में कैमरे की ओर सीधा देखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun viso rilevato. Guarda la fotocamera di fronte con buona luce."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चेहरा आढळला नाही. चांगल्या प्रकाशात कॅमेऱ्याकडे सरळ पाहा."
          }
        }
      }
    },
    "No front camera available (Simulator?). Pick a selfie from the photo library below instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay cámara frontal disponible (¿Simulador?). Elige un selfie de la galería abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de caméra frontale disponible (Simulateur ?). Choisissez plutôt un selfie dans la bibliothèque ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्रंट कैमरा उपलब्ध नहीं (सिम्युलेटर?)। नीचे फ़ोटो लाइब्रेरी से सेल्फ़ी चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera frontale non disponibile (Simulatore?). Scegli un selfie dalla libreria qui sotto."
          }
