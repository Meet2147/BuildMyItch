    "Your routine takes minutes. Your streak is waiting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rutina toma minutos. Tu racha te espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre routine ne prend que quelques minutes. Votre série vous attend."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका रूटीन बस कुछ मिनट का है। आपकी स्ट्रीक इंतज़ार कर रही है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua routine richiede pochi minuti. La tua serie ti aspetta."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची दिनचर्या काही मिनिटांचीच आहे. तुमची स्ट्रीक वाट पाहत आहे."
          }
        }
      }
    },
