            "state": "translated",
            "value": "Respirez-vous par la bouche ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप मुँह से साँस लेते हैं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiri con la bocca?"
          }
