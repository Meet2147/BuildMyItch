    "What matters most to you?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es lo que más te importa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui compte le plus pour vous ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए सबसे ज़रूरी क्या है?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa conta di più per te?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्यासाठी सर्वात महत्त्वाचे काय?"
          }
        }
      }
    },
    "When should we nudge you?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo te avisamos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand devons-nous vous le rappeler ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपको कब याद दिलाएँ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dobbiamo ricordartelo?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्ही तुम्हाला कधी आठवण करावी?"
          }
        }
      }
    },
    "Where consistent training can take you": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta dónde puede llevarte el entrenamiento constante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où un entraînement régulier peut vous mener"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियमित ट्रेनिंग आपको यहाँ तक पहुँचा सकती है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove può portarti un allenamento costante"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियमित सरावाने तुम्ही इथपर्यंत पोहोचू शकता"
          }
        }
      }
    },
    "Which side do you chew on?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué lado masticas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De quel côté mâchez-vous ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किस तरफ़ चबाते हैं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da che lato mastichi?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही कोणत्या बाजूने चावता?"
          }
        }
      }
    },
    "Wide, angular jaw close to your cheekbone width — the classic strong-jaw canvas. Definition work shows fast on this shape.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandíbula ancha y angulosa, cercana al ancho de los pómulos — el lienzo clásico de mandíbula fuerte. El trabajo de definición se nota rápido en esta forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mâchoire large et angulaire, proche de la largeur des pommettes — la base classique d'une mâchoire forte. Le travail de définition se voit vite sur cette forme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चौड़ा, कोणीय जबड़ा जो गाल की हड्डियों जितना चौड़ा है — क्लासिक मज़बूत-जॉ बनावट। इस आकार पर डेफिनिशन की मेहनत जल्दी दिखती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mascella ampia e angolosa, vicina alla larghezza degli zigomi — la base classica della mascella forte. Il lavoro di definizione si vede in fretta su questa forma."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गालाच्या हाडांइतका रुंद, कोनीय जबडा — क्लासिक मजबूत-जॉ ठेवण. या आकारावर मेहनतीचे परिणाम लवकर दिसतात."
          }
        }
      }
    },
    "Wider upper face tapering to a narrow chin — masseter work balances the taper with a stronger jaw base.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte superior más ancha que se afila hacia un mentón estrecho — el trabajo del masetero equilibra esa forma con una base mandibular más fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut du visage plus large s'affinant vers un menton étroit — le travail des masséters équilibre ce dégradé avec une base de mâchoire plus forte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपरी चेहरा चौड़ा, ठोड़ी पतली — मैसेटर की मेहनत मज़बूत जॉ-बेस से इस ढलान को संतुलित करती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte superiore più ampia che si assottiglia verso un mento stretto — il lavoro sui masseteri bilancia la forma con una base mandibolare più forte."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वरचा चेहरा रुंद, हनुवटी निमुळती — मॅसेटरच्या सरावाने मजबूत जॉ-बेस मिळून समतोल येतो."
          }
        }
      }
    },
    "You should feel a stretch at the base of the skull and tension under the chin.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes sentir estiramiento en la base del cráneo y tensión bajo el mentón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez sentir un étirement à la base du crâne et une tension sous le menton."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोपड़ी के आधार पर खिंचाव और ठोड़ी के नीचे तनाव महसूस होना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi sentire un allungamento alla base del cranio e tensione sotto il mento."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कवटीच्या तळाशी ताण आणि हनुवटीखाली ताठरता जाणवली पाहिजे."
          }
        }
      }
    },
    "You're too far away. Bring the camera to about arm's length.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás demasiado lejos. Acerca la cámara a la distancia de un brazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes trop loin. Approchez l'appareil à une longueur de bras."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बहुत दूर हैं। कैमरा बाँह की दूरी पर लाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei troppo lontano. Avvicina la fotocamera a un braccio di distanza."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही खूप दूर आहात. कॅमेरा हाताच्या अंतरावर आणा."
          }
        }
      }
    },
    "Your age": {
      "localizations": {
        "es": {
