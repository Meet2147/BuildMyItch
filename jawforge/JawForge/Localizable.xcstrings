    "Since your first scan": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde tu primer escaneo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis votre premier scan"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले स्कैन से अब तक"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal tuo primo scan"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिल्या स्कॅनपासून"
          }
        }
      }
    },
    "Sit or stand tall, shoulders relaxed, gaze straight ahead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate o ponte erguido, hombros relajados, mirada al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous ou tenez-vous droit, épaules détendues, regard devant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे बैठें या खड़े हों, कंधे ढीले, नज़र सामने।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti o stai dritto, spalle rilassate, sguardo avanti."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ताठ बसा किंवा उभे राहा, खांदे सैल, नजर समोर."
          }
        }
      }
    },
    "Skip this one if you have any neck injury history.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sáltate este si tienes historial de lesión cervical."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez cet exercice si vous avez des antécédents de blessure au cou."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्दन की चोट का इतिहास हो तो यह न करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta questo se hai una storia di infortuni al collo."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मानेच्या दुखापतीचा इतिहास असल्यास हा टाळा."
          }
        }
      }
    },
    "Sleep on your back": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duerme boca arriba"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormez sur le dos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीठ के बल सोएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormi sulla schiena"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठीवर झोपा"
          }
        }
      }
    },
    "Slowly open your mouth while your fist resists the movement.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la boca despacio mientras el puño opone resistencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez lentement la bouche pendant que le poing résiste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे मुँह खोलें, मुट्ठी उसका विरोध करे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri lentamente la bocca mentre il pugno oppone resistenza."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हळूहळू तोंड उघडा, मूठ त्याला विरोध करेल."
          }
        }
      }
    },
    "Smart reminders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios inteligentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels intelligents"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मार्ट रिमाइंडर"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria intelligenti"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मार्ट स्मरण"
          }
        }
      }
    },
    "Snap to an exaggerated \"E\" — corners of the mouth pulled wide.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa de golpe a una «E» exagerada — comisuras bien estiradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez d'un coup à un « É » exagéré — coins de la bouche bien étirés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "झटके से बढ़ा-चढ़ाकर \"ई\" — मुँह के कोने चौड़े खिंचे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa di scatto a una «E» esagerata — angoli della bocca ben tirati."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पटकन अतिशयोक्त \"ई\" — तोंडाचे कोपरे रुंद ताणलेले."
          }
        }
      }
    },
    "Soft angles with similar width and height — sharpening the jaw corner gives this shape the most visible payoff.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ángulos suaves con anchura y altura similares — afilar la esquina mandibular da el resultado más visible en esta forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Angles doux, largeur et hauteur proches — affûter le coin de la mâchoire donne le résultat le plus visible sur cette forme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नरम कोण, चौड़ाई-ऊँचाई लगभग बराबर — जबड़े का कोना तराशने से इस आकार पर सबसे ज़्यादा फ़र्क दिखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Angoli morbidi con larghezza e altezza simili — scolpire l'angolo mandibolare dà il risultato più visibile su questa forma."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मऊ कोन, रुंदी-उंची जवळपास सारखी — जबड्याचा कोपरा धारदार केल्यास या आकारावर सर्वाधिक फरक दिसतो."
          }
        }
      }
    },
    "Sometimes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A veces"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी-कभी"
