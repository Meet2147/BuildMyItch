    "Overdoing it causes TMJ soreness — start with 5 minutes a day.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasarse causa molestias en la ATM — empieza con 5 minutos al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En faire trop provoque des douleurs à l'ATM — commencez par 5 minutes par jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा करने से TMJ में दर्द होता है — दिन में 5 मिनट से शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esagerare causa indolenzimento all'ATM — inizia con 5 minuti al giorno."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अति केल्यास TMJ दुखते — दिवसाला 5 मिनिटांपासून सुरुवात करा."
          }
        }
      }
    },
