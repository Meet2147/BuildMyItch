    "Evens out left/right imbalance in jaw musculature.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige el desequilibrio izquierda/derecha de la musculatura mandibular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige le déséquilibre gauche/droite des muscles de la mâchoire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जबड़े की मांसपेशियों का बाएँ/दाएँ असंतुलन ठीक करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregge lo squilibrio destra/sinistra della muscolatura mandibolare."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जबड्याच्या स्नायूंतील डावे/उजवे असंतुलन दूर करते."
          }
        }
      }
    },
    "Every scan kept forever with trend deltas, not just your last 3.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada escaneo guardado para siempre con tendencias, no solo los últimos 3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque scan conservé pour toujours avec les tendances, pas seulement les 3 derniers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्कैन हमेशा के लिए, ट्रेंड के साथ — सिर्फ़ आख़िरी 3 नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scansione conservata per sempre con le tendenze, non solo le ultime 3."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक स्कॅन कायमचा, ट्रेंडसह — फक्त शेवटचे 3 नाही."
          }
        }
      }
    },
    "Exaggerate saying \"O\" — lips in a tight round shape.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exagera la «O» — labios en círculo apretado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exagérez le « O » — lèvres en cercle serré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बढ़ा-चढ़ाकर \"ओ\" बोलें — होंठ कसे गोल।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esagera la «O» — labbra in cerchio stretto."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अतिशयोक्तीने \"ओ\" म्हणा — ओठ घट्ट गोल."
          }
        }
      }
    },
