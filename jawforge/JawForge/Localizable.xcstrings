        }
      }
    },
    "Dynamic stretch that wakes up the whole lower face.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento dinámico que despierta todo el tercio inferior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étirement dynamique qui réveille tout le bas du visage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डायनामिक स्ट्रेच जो पूरे निचले चेहरे को जगाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allungamento dinamico che risveglia tutto il volto inferiore."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संपूर्ण खालचा चेहरा जागवणारा डायनॅमिक स्ट्रेच."
          }
        }
      }
    },
    "Even light, camera at eye level": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz uniforme, cámara a la altura de los ojos"
          }
